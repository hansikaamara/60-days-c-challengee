#include <stdio.h>
#include <stdlib.h>
#include <math.h>

#define MAX_VEHICLES 10
#define LANES 4

struct Vehicle {
    int vehicleId;
    int speed;
    int lane;
};

void registerData(struct Vehicle vehicles[], int *n);
int detectViolation(int vehicleId, int lane);
void analyzeDensity(struct Vehicle vehicles[], int n, int laneCount[]);
void displayReport(struct Vehicle vehicles[], int n);

int main() {
    struct Vehicle vehicles[MAX_VEHICLES];
    int n = 0;
    int laneCount[LANES] = {0};

    registerData(vehicles, &n);

    for (int i = 0; i < n; i++) {
        if (detectViolation(vehicles[i].vehicleId, vehicles[i].lane)) {
            printf("Vehicle %d: Lane Violation!
", vehicles[i].vehicleId);
        }
    }

    analyzeDensity(vehicles, n, laneCount);
    displayReport(vehicles, n);

    
    int maxLane = 0, minLane = 0;
    for (int i = 0; i < LANES; i++) {
        if (laneCount[i] > laneCount[maxLane]) maxLane = i;
        if (laneCount[i] < laneCount[minLane]) minLane = i;
    }
    printf("Busiest lane: Lane %d (%d vehicles)
", maxLane+1, laneCount[maxLane]);
    printf("Least busy lane: Lane %d (%d vehicles)
", minLane+1, laneCount[minLane]);
    printf("Total traffic volume: %d vehicles
", n);

    return 0;
}

void registerData(struct Vehicle vehicles[], int *n) {
    int count;
    printf("Enter number of vehicles (up to 10): ");
    scanf("%d", &count);
    *n = count;
    for (int i = 0; i < count; i++) {
        printf("Vehicle %d -> Enter VehicleID, Speed, Lane (1-4): ", i+1);
        scanf("%d %d %d", &vehicles[i].vehicleId, &vehicles[i].speed, &vehicles[i].lane);
    }
}

int detectViolation(int vehicleId, int lane) {
    return (vehicleId % 4 != lane) ? 1 : 0;
}

void analyzeDensity(struct Vehicle vehicles[], int n, int laneCount[]) {
    for (int i = 0; i < n; i++) {
        laneCount[vehicles[i].lane - 1]++;
    }
}

void displayReport(struct Vehicle vehicles[], int n) {
    printf("
VehID\tSpeed\tLane\tLaneViolation
");
    for (int i = 0; i < n; i++) {
        printf("%d\t%d\t%d\t%d
", vehicles[i].vehicleId, vehicles[i].speed, vehicles[i].lane,
            detectViolation(vehicles[i].vehicleId, vehicles[i].lane));
    }
}
